{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capricorn.systems/schemas/story-bundle.json",
  "title": "Cap app story bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "fictional", "disclaimer", "personas"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "fictional": {
      "type": "boolean",
      "const": true
    },
    "disclaimer": {
      "type": "string",
      "minLength": 20,
      "pattern": "Illustrative story"
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/persona" }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "dayStep": {
      "type": "object",
      "required": ["time", "title", "text", "shot", "alt"],
      "additionalProperties": false,
      "properties": {
        "time": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "shot": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 }
      }
    },
    "video": {
      "type": "object",
      "required": ["mp4", "webm", "vtt", "poster", "transcript"],
      "additionalProperties": false,
      "properties": {
        "mp4": { "type": "string" },
        "webm": { "type": "string" },
        "vtt": { "type": "string" },
        "poster": { "type": "string" },
        "transcript": { "type": "string", "minLength": 1 }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "age",
        "city",
        "goal",
        "headline",
        "summary",
        "day",
        "before",
        "after",
        "video",
        "features_used",
        "quote",
        "fictional",
        "needs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 1 },
        "age": { "type": "integer", "minimum": 18, "maximum": 99 },
        "city": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 20 },
        "day": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dayStep" }
        },
        "before": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric" }
        },
        "after": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric" }
        },
        "video": { "$ref": "#/$defs/video" },
        "features_used": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "quote": { "type": "string", "minLength": 1 },
        "fictional": { "type": "boolean", "const": true },
        "needs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["family", "health", "money", "travel", "learning", "fun"]
          }
        }
      }
    }
  }
}
